// Publicación del admin en Cloudflare Workers (sitio estático, sin código de servidor).
// Cloudflare corre `npm run build` y luego `npx wrangler deploy`, que sube dist/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joyeria",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // SPA: cualquier ruta desconocida (p. ej. /restablecer-contrasena) devuelve index.html
    "not_found_handling": "single-page-application"
  }
}
